# codebud-web production environment

# URL of the deployed codebud-platform app (Get Started / login handoff target)
NEXT_PUBLIC_PLATFORM_URL=https://app.mycodebud.in

# SMTP for /api/contact -- the contact form and newsletter signup.
# SMTP_PASS is a secret: set it in the hosting provider, never in the repo.
# SMTP_HOST is a PLACEHOLDER -- set it to whatever hosts the mycodebud.in
# mailbox (Zoho: smtp.zoho.in, Google Workspace: smtp.gmail.com, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@mycodebud.in
SMTP_PASS=

# ── FormSubmit (contact form) ─────────────────────────────────────────────────
# The contact form posts to formsubmit.co, which relays to info@mycodebud.in.
# No SMTP needed for it.
#
# ACTIVATION: the first submission after deploy is NOT delivered -- FormSubmit
# emails info@mycodebud.in a confirmation link instead. Click it once and mail
# starts flowing.
#
# Optional. Leave unset and the form posts to info@mycodebud.in directly, which
# puts that address in the client bundle. The activation email also contains a
# random token for the same inbox; set it here to keep the address out of the
# bundle. It is a public identifier, not a secret.
NEXT_PUBLIC_FORMSUBMIT_TOKEN=
